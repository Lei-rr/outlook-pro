# 全部可选。不设置任何变量也能启动：密钥首次自动生成到 <DATA_DIR>/secret.json，
# 初始密码为 admin，登录后可在「系统设置」修改。

# Server
PORT=3000
DATA_DIR=./data
PUBLIC_BASE_URL=

# 覆盖自动生成的密钥（可选）。ENCRYPTION_KEY 一旦有数据就不要改。
# COOKIE_SECRET=
# ENCRYPTION_KEY=

# 初始密码（可选，默认 admin）
# ADMIN_PASSWORD=admin

# 定时刷新默认值（运行时可被「系统设置」覆盖）
TOKEN_REFRESH_ENABLED=0
TOKEN_REFRESH_INTERVAL_HOURS=6
TOKEN_REFRESH_WINDOW_DAYS=60
TOKEN_REFRESH_PER_RUN=200
TOKEN_REFRESH_CONCURRENCY=10
TOKEN_REFRESH_RATE_PER_SEC=10

# Telegram 推送轮询间隔（分钟）
PUSH_INTERVAL_MINUTES=1

# 可选
GPTMAIL_API_KEY=
